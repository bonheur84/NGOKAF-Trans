[database]
host = localhost
port = 3306
user = root
password = your_password
name = ngokaf_trans

# Postes clients : une seule valeur non sensible, fournie par l'installateur.
# Laissez la section [database] vide ou supprimez-la sur les postes de caisse.
[api]
base_url = https://api.ngokaftrans.com
timeout_seconds = 20

[agency]
name = NGOKAF TRANS
address = BP 1245 - Douala, Cameroun
phone = (+237) 6XX XX XX XX
terminal = TERMINAL PRINCIPAL

[session]
timeout_minutes = 30

[luggage]
base_fee = 2500
weight_rate = 200

[paths]
logs = logs
backups = backups
reports = reports
temp = temp
