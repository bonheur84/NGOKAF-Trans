DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ngokaf_trans

# Base MySQL en ligne / managée
# disabled pour MySQL local ; require ou verify_ca pour le cloud.
DB_SSL_MODE=disabled
# Chemin absolu du certificat CA fourni par l'hébergeur, requis avec verify_ca.
DB_SSL_CA=
# Les bases managées existent déjà : mettre false pour empêcher l'application
# d'essayer de créer la base au démarrage.
DB_CREATE_DATABASE=true
DB_CONNECT_TIMEOUT=10

# Serveur API uniquement — ne jamais installer cette valeur sur les postes.
# Générer une valeur aléatoire d'au moins 32 caractères pour DigitalOcean.
API_TOKEN_SECRET=

# Postes Windows : renseigner uniquement l'URL HTTPS publique de l'API.
# Ne jamais placer les variables DB_* ni API_TOKEN_SECRET dans l'installateur.
API_BASE_URL=https://api.ngokaftrans.com
API_TIMEOUT_SECONDS=20
AGENCY_NAME=NGOKAF TRANS
AGENCY_ADDRESS=BP 1245 - Douala, Cameroun
AGENCY_PHONE=(+237) 6XX XX XX XX
TERMINAL_NAME=TERMINAL PRINCIPAL
SESSION_TIMEOUT_MINUTES=30
LUGGAGE_BASE_FEE=2500
LUGGAGE_WEIGHT_RATE=200
